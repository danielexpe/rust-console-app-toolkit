[package]
name = "__BIN__"
version = "0.1.0"
edition = "2021"
rust-version = "1.88"
description = "__DESCRIPTION__"
license = "MIT"
publish = false

[[bin]]
name = "__BIN__"
path = "src/main.rs"

[features]
default = [__DEFAULT_FEATURES__]
audio = ["dep:libloading"]

[dependencies]
clap = { version = "4.5", features = ["derive"] }
crossterm = "0.29"
ratatui = "0.29"
tiny-skia = "0.11"
fontdue = "0.9"
libc = "0.2"
thiserror = "2"
libloading = { version = "0.8", optional = true }

[workspace]
members = [".", "xtask"]
resolver = "2"

[profile.release]
codegen-units = 1
lto = "thin"
